rgba(255, 51, 102, 0.2);\n  }\n\n.telemetry-stage.is-lost > span:nth-child(2) { color: #FF9AAF; }\n\n.telemetry-node.is-healthy,\n  .telemetry-node.is-unconfigured {\n    border-color: #27C272;\n    background: #153322;\n    color: #C7FFDE;\n    box-shadow: 0 0 0 4px rgba(39, 194, 114, 0.09), 0 0 18px rgba(39, 194, 114, 0.38);\n    animation: telemetry-node-pulse 2.4s ease-in-out infinite;\n  }\n\n.telemetry-node.is-warning {\n    border-color: #E09228;\n    background: #30200E;\n    color: #FFD28B;\n    box-shadow: 0 0 0 4px rgba(224, 146, 40, 0.08), 0 0 18px rgba(224, 146, 40, 0.24);\n  }\n\n.telemetry-node.is-overdue {\n    border-color: #FF3366;\n    background: #35121D;\n    color: #FFD0DC;\n    box-shadow: 0 0 0 4px rgba(255, 51, 102, 0.1), 0 0 18px rgba(255, 51, 102, 0.34);\n    animation: telemetry-hazard-pulse 1.8s ease-in-out infinite;\n  }\n\n.telemetry-stage:not(:disabled):hover .telemetry-node {\n    border-color: #27C272;\n    box-shadow: 0 0 12px rgba(39, 194, 114, 0.24);\n  }\n\n.telemetry-stage.is-active {\n    text-shadow: 0 0 10px rgba(39, 194, 114, 0.28);\n  }\n\n@keyframes telemetry-node-pulse {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.62; }\n  }\n\n@keyframes telemetry-scan {\n    from { transform: translateX(0); }\n    to { transform: translateX(390%); }\n  }\n\n@keyframes telemetry-hazard-pulse {\n    0%, 100% { opacity: 1; box-shadow: 0 0 10px rgba(255, 51, 102, 0.22); }\n    50% { opacity: 0.78; box-shadow: 0 0 18px rgba(255, 51, 102, 0.42); }\n  }\n\n@media (prefers-reduced-motion: reduce) {\n    .telemetry-node.is-active,\n    .telemetry-node.is-healthy,\n    .telemetry-node.is-overdue,\n    .telemetry-connector::after,\n    .telemetry-live-dot { animation: none; }\n  }\n\n@media print {\n    body.print-mira * {\n      visibility: hidden;\n    }\n\n    body.print-mira .print-report,\n    body.print-mira .print-report * {\n      visibility: visible;\n    }\n\n    body.print-mira .print-report {\n      position: absolute;\n      